#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
case "$(uname)" in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath >/dev/null 2>&1; then
      basedir=$(cygpath -w "$basedir")
    fi
    ;;
esac
if command -v pwsh.exe >/dev/null 2>&1; then
  exec pwsh.exe -NoProfile -ExecutionPolicy Bypass -File "$basedir\claude-safe.ps1" "$@"
else
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$basedir\claude-safe.ps1" "$@"
fi
